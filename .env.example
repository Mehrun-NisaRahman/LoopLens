# Which model backend to use:
#   mock    -> no API, no cost; returns fake but valid codes (good for tests and UI work)
#   openai  -> any OpenAI-compatible chat API (OpenAI, Gemini's OpenAI endpoint, Ollama, LM Studio...)
LOOPLENS_PROVIDER=mock

# For LOOPLENS_PROVIDER=openai
LOOPLENS_BASE_URL=http://localhost:11434/v1   # e.g. Ollama running locally
LOOPLENS_MODEL=qwen2.5vl:7b                   # any vision-language model your backend serves
LOOPLENS_API_KEY=                              # leave empty for local backends

# --- Option B: Google Gemini (free tier, runs in the cloud) ---
# Get a key at https://aistudio.google.com/apikey , then use these instead:
# LOOPLENS_PROVIDER=openai
# LOOPLENS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LOOPLENS_MODEL=gemini-3.5-flash-lite
# LOOPLENS_API_KEY=paste-your-key-here
